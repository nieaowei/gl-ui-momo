function M.select_proxy(params)
    if not text(params.group,512) or params.group=="" or not text(params.name,512) or params.name=="" then return invalid("Invalid proxy selection") end
    local path="/proxies/"..encoded(params.group)
    local group,err=clash_request("GET",path)
    if not group then return failure(err) end
    if group.type~="Selector" or type(group.all)~="table" or not contains(group.all,params.name) then return invalid("Select an existing member of a Selector group") end
    local result;result,err=clash_request("PUT",path,{name=params.name})
    return result and {success=true} or failure(err)
end
function M.set_clash_mode(params)
    if not text(params.mode,128) or params.mode=="" then return invalid("Invalid Clash mode") end
    local config,err=clash_request("GET","/configs")
    if not config then return failure(err) end
    if not contains(modes(config),params.mode) then return invalid("Unsupported Clash mode") end
    local result;result,err=clash_request("PATCH","/configs",{mode=params.mode})
    return result and {success=true} or failure(err)
end
function M.test_proxy(params)
    if not text(params.name,512) or params.name=="" then return invalid("Invalid proxy name") end
    local result,err=clash_request("GET","/proxies/"..encoded(params.name).."/delay?timeout=5000&url=https%3A%2F%2Fwww.gstatic.com%2Fgenerate_204",nil,8)
    if not result then return failure(err) end
    if type(result.delay)~="number" or result.delay<=0 then return failure("Proxy delay test failed") end
    return {delay=result.delay}
end
function M.update_dashboard()
    local api=dashboard();if not api then return failure("Clash API is not configured") end
    local output,err=execute({"curl","--silent","--show-error","--max-time","120","--request","POST","--header","Authorization: Bearer "..api.secret,"--write-out","\n%{http_code}","http://"..api.host..":"..api.port.."/upgrade/ui"})
    if not output then return failure(err or "Dashboard update failed") end
    local body,status=output:match("^(.*)\n(%d%d%d)$")
    if not status then return failure("Invalid dashboard update response: "..output:sub(1,2048)) end
    if tonumber(status)<200 or tonumber(status)>=300 then
        return failure("Dashboard update failed (HTTP "..status.."): "..body:sub(1,2048))
    end
    return {success=true}
end
function M.save_subscription(params)
    local c=uci.cursor()
    if params.id and params.id~="" and not subscription_id(c,params.id) then return invalid("Subscription not found") end
    for _,key in ipairs({"name","url","info_url","user_agent","prefer"}) do
        if params[key]~=nil and not text(params[key]) then return invalid("Invalid "..key) end
    end
    if not params.name or params.name=="" or not params.url or not params.url:match("^https?://[^%s]+$") then return invalid("Name and HTTP(S) URL are required") end
    if params.info_url and params.info_url~="" and not params.info_url:match("^https?://[^%s]+$") then return invalid("Invalid usage URL") end
    if not contains({"local","remote"},params.prefer) then return invalid("Invalid preference") end
    local id=params.id and params.id~="" and params.id
    if not id then stabilize_ids(c);id=assert(c:add("momo","subscription"));assert(c:rename("momo",id,id)) end
    for _,key in ipairs({"name","url","info_url","user_agent","prefer"}) do if params[key]~=nil then c:set("momo",id,key,params[key]) end end
    if not c:commit("momo") then return failure("Cannot save subscription") end
    return {success=true,id=id}
end
function M.update_subscription(params)
    if not subscription_id(uci.cursor(),params.id) then return invalid("Subscription not found") end
    local result,err=command({"/etc/init.d/momo","update_subscription",params.id},600000)
    if not result then return failure(err) end
    -- Momo's script can exit zero after a failed download; check its UCI result.
    if uci.cursor():get("momo",params.id,"success")~="1" then return failure("Subscription update failed; see application log") end
    return {success=true}
end
function M.reorder_subscriptions(params)
    local c=uci.cursor();local ids,anchor=all_ids(c,"subscription")
    if not array(params.ids) or #params.ids~=#ids then return invalid("Invalid subscription order") end
    local seen={}
    for _,id in ipairs(params.ids) do if not subscription_id(c,id) or seen[id] then return invalid("Invalid subscription order") end;seen[id]=true end
    stabilize_ids(c)
    for index,id in ipairs(params.ids) do c:reorder("momo",id,anchor+index-1) end
    if not c:commit("momo") then return failure("Cannot save subscription order") end
    return {success=true}
end
function M.delete_subscription(params)
    local c=uci.cursor()
    if not subscription_id(c,params.id) then return invalid("Subscription not found") end
    if c:get("momo","config","profile")=="subscription:"..params.id then return invalid("Cannot delete the selected profile") end
    stabilize_ids(c)
    c:delete("momo",params.id)
    if not c:commit("momo") then return failure("Cannot delete subscription") end
    return {success=true}
end
local function editor_target(params)
    local source=params.source
    if source==nil and params.name~=nil then source="file:"..tostring(params.name) end
    if type(source)~="string" then return nil end
    local name=source:match("^file:(.+)$")
    if name then return profile_path(name),source end
    local id=source:match("^subscription:([%w_]+)$");local path
    if id and subscription_id(uci.cursor(),id) then path="/etc/momo/subscriptions/"..id..".json"
    elseif source=="runtime" then path="/etc/momo/run/config.json" end
    if not path or not regular(path) then return nil end
    return path,source,id
end
function M.get_profile(params)
    local path,source,id=editor_target(params)
    if not path then return invalid("Invalid profile source") end
    local value=fs.readfile(path)
    if not value then return failure("Profile does not exist or cannot be read") end
    return {text=value,source=source,readonly=false,prefer=id and (uci.cursor():get("momo",id,"prefer") or "remote") or nil}
end
function M.save_profile(params)
    local path,source,id=editor_target(params)
    if not path then return invalid("Invalid profile source") end
    if not jsonc(params.text) then return invalid("Expected a JSON/JSONC object") end
    if params.prefer_local~=nil and type(params.prefer_local)~="boolean" then return invalid("Invalid preference") end
    local random=(fs.readfile("/proc/sys/kernel/random/uuid") or ""):match("^[%x%-]+")
    if not random then return failure("Cannot create temporary filename") end
    local temp=path:match("^(.*/)")..".momo-"..random
    local file=nixio.open(temp,nixio.open_flags("wronly","creat","excl"),600)
    if not file then return failure("Cannot create profile") end
    local offset=0
    while offset<#params.text do
        local count=file:write(params.text:sub(offset+1));if not count or count==0 then break end;offset=offset+count
    end
    local synced=file:sync();file:close()
    if offset~=#params.text or not synced or not fs.rename(temp,path) then fs.unlink(temp);return failure("Cannot save profile") end
    if id and params.prefer_local~=nil then
        local c=uci.cursor();c:set("momo",id,"prefer",params.prefer_local and "local" or "remote")
        if not c:commit("momo") then return failure("Profile saved, but cannot save preference") end
    end
    return {success=true,source=source}
end
function M.rename_profile(params)
    local old,new=profile_path(params.name),profile_path(params.new_name)
    if not old or not new or not fs.stat(old) then return invalid("Invalid filename") end
    if old==new then return {success=true,source="file:"..params.name} end
    if fs.lstat(new) then return invalid("Destination already exists") end
    if not fs.rename(old,new) then return failure("Cannot rename profile") end
    local c=uci.cursor()
    if c:get("momo","config","profile")=="file:"..params.name then
        c:set("momo","config","profile","file:"..params.new_name)
        if not c:commit("momo") then fs.rename(new,old);return failure("Cannot update selected profile") end
    end
    return {success=true,source="file:"..params.new_name}
end
function M.delete_profile(params)
    local path=profile_path(params.name)
    if not path or not fs.stat(path) then return invalid("Invalid filename") end
    if uci.cursor():get("momo","config","profile")=="file:"..params.name then return invalid("Cannot delete the selected profile") end
    if not fs.unlink(path) then return failure("Cannot delete profile") end
    return {success=true}
end
function M.prepare_download(params)
    if not filename(params.name) or type(params.text)~="string" then return invalid("Invalid download") end
    local dir="/tmp/momo-ui-downloads"
    local st=fs.lstat(dir)
    if st and st.type~="dir" then return failure("Invalid download directory") end
    if not st and not fs.mkdir(dir) then return failure("Cannot create download directory") end
    fs.chmod(dir,700)
    for name in fs.dir(dir) or function() end do
        if name:match("^[%x%-]+%.bin$") then
            local old=fs.lstat(dir.."/"..name)
            if old and old.type=="reg" and os.time()-(old.mtime or 0)>3600 then fs.unlink(dir.."/"..name) end
        end
    end
    local id=(fs.readfile("/proc/sys/kernel/random/uuid") or ""):match("^[%x%-]+")
    if not id then return failure("Cannot create download") end
    local path=dir.."/"..id..".bin"
    local file=nixio.open(path,nixio.open_flags("wronly","creat","excl"),600)
    if not file then return failure("Cannot create download") end
    local offset=0
    while offset<#params.text do
        local count=file:write(params.text:sub(offset+1));if not count or count==0 then break end;offset=offset+count
    end
    file:close()
    if offset~=#params.text then fs.unlink(path);return failure("Cannot write download") end
    return {path=path}
end
return M

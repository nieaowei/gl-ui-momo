-- Authenticated GL.iNet SDK4 adapter. UI and validation share one field schema.
local uci = require "uci"
local json = require "cjson.safe"
local fs = require "nixio.fs"
local nixio = require "nixio"
local ubus = require "oui.ubus"
local rpc = require "oui.rpc"
local ip = require "luci.ip"
local M = {}
local dashboard
local schema_text = assert(fs.readfile("/usr/share/momo-ui/schema.json"))
local schema = assert(json.decode(schema_text))
local fields, rule_fields = {}, {}
for _, section in ipairs(schema.sections) do
    fields[section.key] = {}
    for _, group in ipairs(section.groups) do
        for _, field in ipairs(group.fields) do fields[section.key][field.key] = field end
    end
end
for name, rule in pairs(schema.rules) do
    rule_fields[name] = {}
    for _, field in ipairs(rule.fields) do rule_fields[name][field.key] = field end
end
local function invalid(message) return rpc.ERROR_CODE_INVALID_PARAMS, message end
local function failure(message) return {err_code = -1, err_msg = message} end
local function bus(object, method, args, timeout)
    -- SDK4's socket calls yield; Lua 5.1 cannot wrap them in pcall.
    local result,err=ubus.call(object,method,args or {},timeout)
    if type(result)~="table" then return nil,"RPC "..object.."."..method..": "..tostring(err or "Invalid response") end
    return result
end
local function execute(args,timeout)
    -- SDK4 proxies commands over a socket; wait() returns output, not an exit code.
    local process, err = ngx.pipe.spawn(args,{stdout_read_timeout=timeout or 125000,merge_stderr=true})
    if not process then return nil, err end
    local output, read_err = process:stdout_read_all()
    if not output or output=="" then return nil,read_err or "Command returned no response" end
    return output
end
local function command(args,timeout)
    -- SDK4 has no process exit status API. A fixed shell wrapper records it;
    -- command arguments remain separate argv entries and are never interpolated.
    local wrapped={"/bin/sh","-c",'"$@" 2>&1; code=$?; printf "\\nMOMO_UI_EXIT:%s\\n" "$code"',"momo-ui"}
    for _,value in ipairs(args) do wrapped[#wrapped+1]=value end
    local output,err=execute(wrapped,timeout or 15000)
    if not output then return nil,err end
    local value,status=output:match("^(.*)\nMOMO_UI_EXIT:(%d+)\n$")
    if not status then return nil,"Command timed out or returned incomplete output" end
    if tonumber(status)~=0 then return nil,"Command failed (exit "..status.."): "..value:sub(1,512) end
    return value
end
local function package_version(name)
    for _,source in ipairs({{"/lib/apk/db/installed","P:","V:"},{"/usr/lib/opkg/status","Package: ","Version: "}}) do
        local database=fs.readfile(source[1]) or ""
        for record in (database.."\n\n"):gmatch("(.-)\n\n") do
            local package,version
            for line in record:gmatch("[^\n]+") do
                if line:sub(1,#source[2])==source[2] then package=line:sub(#source[2]+1) end
                if line:sub(1,#source[3])==source[3] then version=line:sub(#source[3]+1) end
            end
            if package==name and version then return version end
        end
    end
    return ""
end
local function versions()
    local output=command({"/usr/bin/sing-box","version"},10000)
    return {app=package_version("momo"),core=output and output:match("sing%-box version ([^%s]+)") or "",ui=package_version("gl-ui-momo")}
end
local function service(action)
    local result, err = bus("rc", "init", {name = "momo", action = action}, 120000)
    if not result then return failure("Cannot control momo: " .. tostring(err)) end
    return {success = true}
end
local function text(value, limit)
    return type(value) == "string" and #value <= (limit or 4096) and not value:find("[%z\1-\31\127]")
end
local function filename(name)
    return text(name,255) and name ~= "" and not name:match("^%.") and not name:find("[/\\:]") and not name:find("..",1,true)
end
local function regular(path)
    local stat = fs.lstat(path)
    return not stat or stat.type == "reg"
end
local function profile_path(name)
    if not filename(name) then return nil end
    local path = "/etc/momo/profiles/" .. name
    return regular(path) and path or nil
end
local function subscription_id(c, id)
    return type(id) == "string" and id:match("^[%w_]+$") and c:get("momo",id) == "subscription"
end
local function profiles(c)
    local list = {}
    for name in fs.dir("/etc/momo/profiles") or function() end do
        local path = profile_path(name)
        if path and fs.stat(path,"type") == "reg" then list[#list+1] = {value="file:"..name,label=name} end
    end
    table.sort(list,function(a,b) return a.value < b.value end)
    c:foreach("momo","subscription",function(s) list[#list+1] = {value="subscription:"..s[".name"],label=s.name or s[".name"]} end)
    return list
end
local function array(v)
    if type(v) ~= "table" then return false end
    for k in pairs(v) do if type(k) ~= "number" or k < 1 or k > #v or k % 1 ~= 0 then return false end end
    return true
end
local function uint(v) return text(v,24) and v:match("^%d+$") ~= nil end
local function contains(values,v) for _,value in ipairs(values or {}) do if value == v then return true end end return false end
local function address(v, version)
    if not text(v,128) then return false end
    local ok, result = pcall(ip.new,v)
    return ok and result and (version == 4 and result:is4() or version == 6 and result:is6()) or false
end
local function cron(v)
    if not text(v,128) then return false end
    local bounds={{0,59},{0,23},{1,31},{1,12},{0,7}}
    local aliases={{},{},{},{JAN=1,FEB=2,MAR=3,APR=4,MAY=5,JUN=6,JUL=7,AUG=8,SEP=9,OCT=10,NOV=11,DEC=12},{SUN=0,MON=1,TUE=2,WED=3,THU=4,FRI=5,SAT=6}}
    local index=0
    for field in v:gmatch("%S+") do
        index=index+1
        if not bounds[index] then return false end
        field=field:upper():gsub("%a+",function(name) return tostring(aliases[index][name] or "invalid") end)
        if field:find("[^%d*/,%-%s]") or field:match("^,") or field:match(",$") or field:find(",,",1,true) then return false end
        local low,high=unpack(bounds[index])
        for item in field:gmatch("[^,]+") do
            local base,step=item:match("^([^/]+)/(%d+)$")
            if item:find("/",1,true) and (not base or tonumber(step)<1 or tonumber(step)>high+1) then return false end
            base=base or item
            if base~="*" then
                local a,b=base:match("^(%d+)%-(%d+)$")
                if not a then a=base:match("^%d+$");b=a end
                if not a or tonumber(a)<low or tonumber(b)>high or tonumber(a)>tonumber(b) then return false end
            end
        end
    end
    return index==5
end
local function list_item(v,hint)
    if not text(v,512) or v=="" then return false end
    if hint=="ip4" then return address(v,4) end
    if hint=="ip6" then return address(v,6) end
    if hint=="mac" then return v:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") ~= nil end
    if hint=="dscp" then return uint(v) and tonumber(v)<=63 end
    if hint=="fwmark" then
        local function mark(s) return s:match("^0[xX]%x+$") or s:match("^%d+$") end
        local a,b=v:match("^([^/]+)/([^/]+)$")
        return a and mark(a) and mark(b) or not v:find("/",1,true) and mark(v) or false
    end
    return v:match("^[%w_.@/%-]+$") ~= nil and not v:find("..",1,true)
end
local function valid(field,v)
    if not field then return false end
    if field.kind=="list" then
        if not array(v) or #v>1024 then return false end
        for _,item in ipairs(v) do if not list_item(item,field.hint) then return false end end
        return true
    end
    if not text(v) then return false end
    if v=="" then return field.optional==true end
    if field.kind=="flag" or field.kind=="tristate" then return v=="0" or v=="1" end
    if field.kind=="uint" then return uint(v) end
    if field.kind=="port" then return uint(v) and tonumber(v)>=1 and tonumber(v)<=65535 end
    if field.kind=="cron" then return cron(v) end
    if field.kind=="enum" then return contains(field.values,v) end
    if field.kind=="url" then return v:match("^https?://[^%s]+$") ~= nil end
    if field.kind=="listen" then
        local host,port=v:match("^%[([^%]]+)%]:(%d+)$")
        if not host then host,port=v:match("^([^:]+):(%d+)$") end
        return host and (address(host,4) or address(host,6)) and uint(port) and tonumber(port)>=1 and tonumber(port)<=65535 or false
    end
    if field.kind=="ports" then
        local count=0
        for part in v:gmatch("%S+") do
            count=count+1
            local a,b=part:match("^(%d+)[%-:](%d+)$")
            if not a then a=part:match("^%d+$");b=a end
            if not a or tonumber(a)>65535 or tonumber(b)>65535 or tonumber(a)>tonumber(b) then return false end
        end
        return count>0
    end
    return true
end
local function read_options(c,id,definitions)
    local item={}
    for key,field in pairs(definitions) do
        local value=c:get("momo",id,key)
        if field.kind=="list" and type(value)=="string" then value={value} end
        item[key]=value
    end
    return item
end
local function save_options(c,id,options)
    for key,value in pairs(options) do
        local old=c:get("momo",id,key)
        local remove=value=="" or type(value)=="table" and #value==0
        local same=old==value
        if type(value)=="table" then
            if type(old)=="string" then same=#value==1 and value[1]==old
            elseif type(old)=="table" then
                same=#old==#value
                for index,item in ipairs(value) do if old[index]~=item then same=false end end
            end
        end
        if remove then if old~=nil then c:delete("momo",id,key) end
        elseif not same then assert(c:set("momo",id,key,value),"Cannot save "..key) end
    end
end
local function all_ids(c,kind)
    local ids,anchor={},nil
    c:foreach("momo",kind,function(s) ids[#ids+1]=s[".name"];anchor=anchor or s[".index"] end)
    return ids,anchor or 0
end
local function stabilize_ids(c)
    -- Anonymous IDs are regenerated from section positions after a commit.
    -- Keep existing IDs as explicit names before structural changes, so moving
    -- ACLs/subscriptions cannot detach the selected profile from its cache file.
    local ids={}
    c:foreach("momo",nil,function(s) if s[".anonymous"] then ids[#ids+1]=s[".name"] end end)
    for _,id in ipairs(ids) do assert(c:rename("momo",id,id)) end
end
function M.get_status()
    local services,err=bus("service","list",{name="momo"})
    if not services then return failure(err) end
    local running=false
    for _,instance in pairs((services.momo or {}).instances or {}) do running=running or instance.running==true end
    return {running=running,enabled=uci.cursor():get("momo","config","enabled")=="1",clash_api=running and dashboard()~=nil}
end
function M.get_config()
    local c=uci.cursor()
    local version=versions()
    local settings,rules,subscriptions={},{},{}
    for section,definitions in pairs(fields) do settings[section]=read_options(c,section,definitions) end
    for kind,definitions in pairs(rule_fields) do
        rules[kind]={}
        c:foreach("momo",kind,function(s)
            local row=read_options(c,s[".name"],definitions);row.id=s[".name"]
            rules[kind][#rules[kind]+1]=row
        end)
    end
    c:foreach("momo","subscription",function(s)
        local item={id=s[".name"]}
        for _,field in ipairs(schema.subscription.fields) do item[field.key]=s[field.key] end
        subscriptions[#subscriptions+1]=item
    end)
    local listen=c:get("uhttpd","main","listen_http")
    if type(listen)=="table" then listen=listen[1] end
    local port=tonumber(tostring(listen or ""):match(":(%d+)$")) or 8080
    return {schema=schema,settings=settings,rules=rules,subscriptions=subscriptions,profiles=profiles(c),version=version,luci_port=port,luci_available=fs.stat("/www/luci-static/resources/view/momo/app.js","type")=="reg"}
end
function M.set_config(params)
    if type(params.settings)~="table" then return invalid("Missing settings") end
    local c=uci.cursor();local available={}
    for _,p in ipairs(profiles(c)) do available[p.value]=true end
    for section,options in pairs(params.settings) do
        if not fields[section] or type(options)~="table" then return invalid("Unknown section") end
        for key,value in pairs(options) do
            if not valid(fields[section][key],value) then return invalid("Invalid "..section.."."..key) end
            if section=="config" and key=="profile" and value~="" and not available[value] then return invalid("Profile not found") end
        end
    end
    if params.rules~=nil then
        if type(params.rules)~="table" then return invalid("Invalid rules") end
        for kind,rows in pairs(params.rules) do
            if not rule_fields[kind] or not array(rows) or #rows>512 then return invalid("Invalid rule group") end
            local seen={}
            for _,row in ipairs(rows) do
                if type(row)~="table" then return invalid("Invalid rule") end
                if row.id and row.id~="" then
                    if type(row.id)~="string" or seen[row.id] or c:get("momo",row.id)~=kind then return invalid("Invalid rule ID") end
                    seen[row.id]=true
                end
                for key,value in pairs(row) do
                    if key~="id" and not valid(rule_fields[kind][key],value) then return invalid("Invalid rule field "..tostring(key)) end
                end
            end
        end
    end
    if params.rules and next(params.rules) then stabilize_ids(c) end
    for section,options in pairs(params.settings) do save_options(c,section,options) end
    for kind,rows in pairs(params.rules or {}) do
        local old,anchor=all_ids(c,kind);local keep={}
        for _,row in ipairs(rows) do if row.id and row.id~="" then keep[row.id]=true end end
        for _,id in ipairs(old) do if not keep[id] then c:delete("momo",id) end end
        for index,row in ipairs(rows) do
            local id=row.id and row.id~="" and row.id or assert(c:add("momo",kind))
            assert(c:rename("momo",id,id))
            local options={};for key,value in pairs(row) do if key~="id" then options[key]=value end end
            save_options(c,id,options);assert(c:reorder("momo",id,anchor+index-1))
        end
    end
    if not c:commit("momo") then return failure("Cannot save configuration") end
    if params.apply==true then return service("restart") end
    return {success=true}
end
function M.get_hints()
    local function names(path)
        local values={}
        for line in (fs.readfile(path) or ""):gmatch("[^\n]+") do
            local name=line:match("^([^:]+):");if name then values[#values+1]=name end
        end
        table.sort(values);return values
    end
    local c=uci.cursor();local result={users=names("/etc/passwd"),groups=names("/etc/group"),cgroups={}}
    local function cgroups(path,prefix,depth)
        if depth>16 or #result.cgroups>=2048 then return end
        for name in fs.dir(path) or function() end do
            if #result.cgroups>=2048 then return end
            local relative=prefix..name
            if name~="." and name~=".." and relative~="services/momo" and not relative:match("^services/momo/") then
                local stat=fs.lstat(path.."/"..name)
                if stat and stat.type=="dir" then
                    result.cgroups[#result.cgroups+1]=relative;cgroups(path.."/"..name,relative.."/",depth+1)
                end
            end
        end
    end
    if fs.stat("/sys/fs/cgroup/cgroup.controllers") then cgroups("/sys/fs/cgroup","",0) end
    table.sort(result.cgroups)
    result.interfaces={}
    c:foreach("network","interface",function(s) if s[".name"]~="loopback" then result.interfaces[#result.interfaces+1]=s[".name"] end end)
    local hosts=bus("luci-rpc","getHostHints")
    result.ip4,result.ip6,result.mac={},{},{}
    if hosts then
        for mac,host in pairs(hosts.hosts or hosts or {}) do
            if type(host)=="table" then
                result.mac[#result.mac+1]={value=mac,label=(host.name or mac).." ("..mac..")"}
                for _,pair in ipairs({{"ip4","ipaddrs"},{"ip6","ip6addrs"}}) do
                    for _,addr in ipairs(host[pair[2]] or {}) do result[pair[1]][#result[pair[1]]+1]={value=addr,label=(host.name or mac).." ("..addr..")"} end
                end
            end
        end
    end
    return result
end
function M.service(params)

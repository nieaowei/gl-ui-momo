-- JSONC: strip comments and trailing commas without touching quoted strings.
local function jsonc(value)
    if type(value)~="string" then return nil end
    value=value:gsub("^\239\187\191","")
    local out,i,quoted={},1,false
    while i<=#value do
        local ch=value:sub(i,i);local nextch=value:sub(i+1,i+1)
        if quoted then
            out[#out+1]=ch
            if ch=="\\" then i=i+1;out[#out+1]=value:sub(i,i) elseif ch=='"' then quoted=false end
        elseif ch=='"' then quoted=true;out[#out+1]=ch
        elseif ch=="/" and nextch=="/" then
            local ending=value:find("\n",i+2,true);i=ending and ending-1 or #value;out[#out+1]=" "
        elseif ch=="/" and nextch=="*" then
            local ending=value:find("*/",i+2,true);if not ending then return nil end;i=ending+1;out[#out+1]=" "
        else out[#out+1]=ch end
        i=i+1
    end
    if quoted then return nil end
    value=table.concat(out);out={};i=1;quoted=false;local previous=""
    while i<=#value do
        local ch=value:sub(i,i)
        if quoted then
            out[#out+1]=ch
            if ch=="\\" then i=i+1;out[#out+1]=value:sub(i,i) elseif ch=='"' then quoted=false end
        elseif ch=='"' then quoted=true;out[#out+1]=ch
        elseif ch=="," then
            local nextpos=value:find("%S",i+1)
            local rest=nextpos and value:sub(nextpos,nextpos)
            if rest=="}" or rest=="]" then
                if previous=="{" or previous=="[" or previous==":" or previous=="," then return nil end
            else out[#out+1]=ch end
        else out[#out+1]=ch end
        if not ch:match("%s") then previous=ch end
        i=i+1
    end
    local clean=table.concat(out)
    if not clean:match("^%s*{") then return nil end
    return json.decode(clean)
end
dashboard=function()
    local profile=jsonc(fs.readfile("/etc/momo/run/config.json")) or {}
    local api=((profile.experimental or {}).clash_api or {})
    local listen=api.external_controller or ""
    if type(listen)~="string" then return nil end
    local host,port=listen:match("^%[([^%]]+)%]:(%d+)$")
    if not host then host,port=listen:match("^([^:]*):(%d+)$") end
    port=tonumber(port)
    if not port or port<1 or port>65535 then return nil end
    if not host then return nil end
    if host=="" or host=="localhost" or host=="0.0.0.0" then host="127.0.0.1" elseif host=="::" then host="::1" end
    if not (address(host,4) or address(host,6)) then return nil end
    if host:find(":",1,true) then host="["..host.."]" end
    return {port=port,secret=api.secret or "",host=host}
end
function M.get_dashboard() return dashboard() or failure("Clash API is not configured") end
local function encoded(value)
    return (value:gsub("[^A-Za-z0-9_.~%-]",function(ch) return string.format("%%%02X",ch:byte()) end))
end
-- Fixed local endpoints only. The browser never receives API credentials here.
local function clash_request(method,path,body,seconds)
    local api=dashboard();if not api then return nil,"Clash API is not configured" end
    seconds=seconds or 10
    local args={"curl","--silent","--show-error","--noproxy","*","--connect-timeout","3","--max-time",tostring(seconds),"--request",method,"--header","Authorization: Bearer "..api.secret,"--write-out","\n%{http_code}"}
    if body then args[#args+1]="--header";args[#args+1]="Content-Type: application/json";args[#args+1]="--data-binary";args[#args+1]=json.encode(body) end
    args[#args+1]="http://"..api.host..":"..api.port..path
    local output,err=execute(args,(seconds+5)*1000)
    if not output then return nil,err end
    local content,status=output:match("^(.*)\n(%d%d%d)$")
    if not status then return nil,"Invalid Clash API response" end
    local value={};if content~="" then value=json.decode(content) end
    if tonumber(status)<200 or tonumber(status)>=300 then
        local message=type(value)=="table" and value.message or content
        return nil,"Clash API HTTP "..status..": "..tostring(message):sub(1,512)
    end
    if type(value)~="table" then return nil,"Invalid Clash API JSON response" end
    return value
end
local function modes(config)
    local values={}
    for _,mode in ipairs(type(config["mode-list"])=="table" and config["mode-list"] or {"Rule","Global","Direct"}) do
        if text(mode,128) and mode~="" then values[#values+1]=mode end
    end
    return values
end
function M.get_proxies()

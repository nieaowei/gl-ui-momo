    if not config then return failure(err) end
    local nodes,groups,seen={},{},{}
    for name,item in pairs(result.proxies) do
        if type(item)=="table" then
            local history=type(item.history)=="table" and item.history or {}
            local latest=history[#history];if type(latest)~="table" then latest={} end
